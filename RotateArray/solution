class Solution {
    public void rotate(int[] nums, int k) {
     int[]arr={1,2,3,4,5,6,7};
        int n=nums.length;
        int K=3;
        k = k%n;
        Reverse(nums,0,n-1);
        Reverse(nums,0,k-1);
        Reverse(nums,k,n-1);
        
    }
    public static void Reverse(int arr[],int i, int j) {
       while(i<j){
        int temp=arr[i];
        arr[i]=arr[j];
        arr[j]=temp;
        i++;
        j--;
        
    
        }
        
    }
    
}
   
    
